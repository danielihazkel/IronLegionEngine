// See ../../mod.json5. Zone raster (movement.zone_cell = 2 m) cell centres
// are at 1, 3, 5, 7 on both axes.
{
  id: "tiny:tiny",
  name_key: "tiny.maps.tiny.name",
  size: { w: 8, h: 8 },
  heightmap: { cell: 4, path: "maps/tiny.hgt", scale: 0.01 },
  base_zone: "rome:open",
  zones: [
    // Forest over the south-west quarter.
    { type: "rome:forest", polygon: [[0, 0], [4, 0], [4, 4], [0, 4]] },
    // Rock triangle below the diagonal in the north-east quarter.
    { type: "rome:rock", polygon: [[4, 4], [8, 4], [8, 8]] },
    // Ford across the river, overriding the rock where they overlap.
    { type: "rome:ford", polygon: [[6, 4.5], [8, 4.5], [8, 7.5], [6, 7.5]] },
  ],
  rivers: [
    { width: 2.5, points: [[0, 6], [8, 6]] },
  ],
  deployment: [
    { side: 0, polygon: [[0, 0], [8, 0], [8, 2], [0, 2]] },
  ],
  structures: [],
  siege_points: [],
}
