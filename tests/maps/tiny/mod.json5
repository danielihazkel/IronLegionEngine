// A hand-written 8 x 8 m map for the LoadedMap tests (T1-030). Heights are
// the plane h(x, y) = x / 4 + y so bilinear sampling is exact; the zones,
// river and ford exercise polygon order, river capsules and crossings.
{
  id: "tiny",
  name_key: "tiny.mod.name",
  version: "0.1.0",
  engine_version: "*",
  dependencies: [{ id: "rome", version: ">=0.1.0" }],
}
