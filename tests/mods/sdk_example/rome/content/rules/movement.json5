// Movement, pathfinding, steering and collision tunables
// (Simulation Spec 5 and 15.1; schema docs/schemas/rules-movement.schema.json).
// Every field is required: the engine carries no numeric defaults.
{
  // Pathfinding (SIM-MOVE-001..005)
  nav_cell: 4,                 // m
  hpa_cluster: 16,             // nav cells (Phase 3)
  hpa_gate_split: 6,           // nav cells (Phase 3)
  paths_per_tick: 8,

  // Regiment movement (SIM-MOVE-010..013)
  wheel_rate: 45,              // degrees per second
  waypoint_radius: 2,          // m
  straggler_radius: 3,         // file spacings (sf)
  straggler_fraction: 0.25,
  straggler_slowdown: 0.5,

  // Soldier steering (SIM-CORE-011, SIM-MOVE-020..024)
  slot_arrive_radius: 0.3,     // m
  slot_leave_radius: 0.6,      // m
  sep_weight: 1.5,
  sep_margin: 0.2,             // m
  sep_max_neighbours: 8,
  arrive_damping: 0.5,
  lookahead_ticks: 4,
  soldier_turn_rate: 360,      // degrees per second

  // Terrain (SIM-MOVE-030, SIM-MOVE-032)
  slope_penalty: 2.0,
  slope_bonus: 0.5,
  slope_min_mult: 0.4,
  slope_max_mult: 1.2,
  ford_defence_mult: 0.7,

  // Collision (SIM-MOVE-041)
  collision_iterations: 2,

  // Grids (TDD 5, TDD 6.2)
  spatial_cell: 4,             // m
  anchor_cell: 16,             // m
  zone_cell: 2,                // m
}
