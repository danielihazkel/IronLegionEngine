// Morale tunables (Simulation Spec 7 and 15.1; schema
// docs/schemas/rules-morale.schema.json). Every field is required: the
// engine carries no numeric defaults.
{
  // States (SIM-MOR-003)
  t_unsettled: 70,
  t_shaken: 50,
  t_broken: 30,
  t_routing: 15,
  hysteresis: 5,

  // Rally, shatter, contagion (SIM-MOR-031..033)
  rally_margin: 15,
  rally_safe_radius: 50,       // m
  max_routs: 2,
  shatter_strength: 0.25,
  general_death_shock: 20,     // SIM-MOR-014
  rout_shock: 5,
  rout_shock_radius: 30,       // m

  // One-time penalties (SIM-MOR-025, SIM-MOR-026)
  disengage_penalty: 5,
  charged_penalty: 8,          // half of it from the front

  // Factor references (SIM-MOR-010..024)
  casualty_rate_ref: 0.05,
  casualty_total_ref: 0.5,
  fatigue_start: 0.5,
  ally_radius: 40,             // m
  allies_ref: 3,
  routing_ref: 2,
  outnumber_ref: 2,
  engage_fatigue_ticks: 2400,  // 2 min
  safe_radius: 60,             // m
  exp_bonus: 0.02,             // SIM-MOR-001, per experience level

  // Factor weights, points per second at full effect (SIM-MOR-002)
  w: {
    casualty_rate: -6,
    casualty_total: -2,
    fatigue: -1.5,
    general_aura: 1,
    allies_near: 1,
    allies_routing: -3,
    high_ground: 0.5,
    fear: -4,
    flanked: -3,
    outnumbered: -2,
    integrity: -1.5,
    engaged_duration: -1,
    winning: 2,
    recovery: 3,
  },

  // Multipliers per state: attack, defence, attack interval, speed
  // (SIM-MOR-004). Routing soldiers never attack, so their interval is 1.
  state_mults: {
    steady:    { attack: 1.0,  defence: 1.0,  interval: 1.0,  speed: 1.0 },
    unsettled: { attack: 0.95, defence: 0.95, interval: 1.05, speed: 1.0 },
    shaken:    { attack: 0.85, defence: 0.85, interval: 1.15, speed: 1.0 },
    broken:    { attack: 0.7,  defence: 0.7,  interval: 1.3,  speed: 1.0 },
    routing:   { attack: 0.0,  defence: 0.5,  interval: 1.0,  speed: 1.1 },
  },
}
