      general: { unit_type: "greece:general", rank: 1, name_key: "rome.generals.placeholder" },
      regiments: [
        { id: 1, unit_type: "greece:hoplite", count: 160, formation: "rome:phalanx", position: [300, 150], facing_deg: 0 },
      ],
    },
    {
