// Phase 2 exit criterion (Simulation Spec 15.3 row 9, T2-082): the engine
// AI (side 1, player 255) beats a passive player army (side 0, player 0,
// no commands: its ranged units still shoot at will, its infantry stands)
// in every seed. Mixed armies of 620 a side, pre-placed 250 m apart on the
// south field (plan I26); the AI deploys itself only when unplaced, which
// crates/il_sim_battle/tests/ai.rs covers.
//
// RegimentIds: side 0 = 0..6 (hastati 0-2, velites 3, archers 4, cavalry 5,
// the general's 20-man bodyguard 6), side 1 = 7..13 in the same order.
{
  map_id: "rome:test_field",
  seed: 0,
  // T2-112: the determinism test's budget (restore at 1,000 per Simulation Spec 15.3).
  determinism: { ticks: 1500, snapshot_at: 1000 },
  sides: [
    {
      faction: "rome:rome", player: 0, deployment_zone: 0,
      general: { unit_type: "rome:general", rank: 1, name_key: "rome.generals.placeholder", bodyguard: 7 },
      regiments: [
        { id: 1, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [250, 150], facing_deg: 0 },
        { id: 2, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [250, 200], facing_deg: 0 },
        { id: 3, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [250, 100], facing_deg: 0 },
        { id: 4, unit_type: "rome:velites", count: 120, formation: "rome:loose", position: [270, 150], facing_deg: 0 },
        { id: 5, unit_type: "persia:archer", count: 60, formation: "rome:loose", position: [225, 150], facing_deg: 0 },
        { id: 6, unit_type: "persia:cavalry", count: 60, formation: "rome:wedge", position: [230, 250], facing_deg: 0 },
        { id: 7, unit_type: "rome:hastati", count: 20, formation: "rome:line", position: [210, 150], facing_deg: 0 },
      ],
    },
    {
      faction: "rome:rome", player: 255, deployment_zone: 1,
      general: { unit_type: "rome:general", rank: 1, name_key: "rome.generals.placeholder", bodyguard: 14 },
      regiments: [
        { id: 7, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [500, 150], facing_deg: 180 },
        { id: 8, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [500, 200], facing_deg: 180 },
        { id: 9, unit_type: "rome:hastati", count: 120, formation: "rome:line", position: [500, 100], facing_deg: 180 },
        { id: 10, unit_type: "rome:velites", count: 120, formation: "rome:loose", position: [480, 150], facing_deg: 180 },
        { id: 11, unit_type: "persia:archer", count: 60, formation: "rome:loose", position: [525, 150], facing_deg: 180 },
        { id: 12, unit_type: "persia:cavalry", count: 60, formation: "rome:wedge", position: [520, 250], facing_deg: 180 },
        { id: 14, unit_type: "rome:hastati", count: 20, formation: "rome:line", position: [540, 150], facing_deg: 180 },
      ],
    },
  ],
  commands: [],
  bands: {
    seeds: 20,
    seed_base: 9000,
    tick_limit: 12000,
    assertions: [
      { name: "the AI beats a passive army", kind: "winner", side: 1, min_fraction: 1.0 },
    ],
  },
}
