{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironlegion.dev/schemas/map-def.schema.json",
  "title": "Iron Legion battle map",
  "description": "A battle map definition (content/maps/*.json5, Modding SDK 6.1): metadata, a 16-bit heightmap sidecar, zone polygons referencing zone types, rivers, deployment areas and the fields reserved for sieges (REQ-SIM-045). Distances are metres, x right, y forward.",
  "x-schema-version": 1,
  "$defs": {
    "contentId": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "locKey": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
    "assetPath": { "type": "string", "pattern": "^(?!\\.\\.)(?!/)[^\\\\]*$" },
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "polygon": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" }, "description": "Closed polygon, vertices in order, no repeated last vertex." },
    "edge": { "enum": ["north", "south", "east", "west"] }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name_key", "size", "heightmap", "deployment"],
  "properties": {
    "$override": { "enum": ["merge", "replace"] },
    "$delete": { "const": true },
    "$from": { "$ref": "#/$defs/contentId" },
    "deprecated": { "type": "string" },
    "id": { "$ref": "#/$defs/contentId" },
    "name_key": { "$ref": "#/$defs/locKey" },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["w", "h"],
      "properties": { "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 }, "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 } }
    },
    "campaign_terrain_tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "default": [] },
    "weather_allowed": { "type": "array", "items": { "enum": ["clear", "rain", "fog"] }, "default": ["clear"] },
    "heightmap": {
      "type": "object", "additionalProperties": false, "required": ["cell", "path"],
      "properties": {
        "cell": { "type": "number", "exclusiveMinimum": 0, "maximum": 64, "description": "Metres per height sample (SIM-CORE-001 height_cell)." },
        "path": { "$ref": "#/$defs/assetPath", "description": "16-bit little-endian raw heights (.hgt) under assets_root, row-major from y = 0, ceil(w/cell)+1 by ceil(h/cell)+1 samples." },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000, "default": 0.01, "description": "Metres per raw unit." }
      }
    },
    "zones": {
      "type": "array", "default": [],
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "polygon"],
        "properties": { "type": { "$ref": "#/$defs/contentId", "description": "A zone type ContentId (content/zones/)." }, "polygon": { "$ref": "#/$defs/polygon" } }
      },
      "description": "Later polygons override earlier ones where they overlap. Ford and bridge crossings are zone polygons of a passable zone type laid over a river."
    },
    "rivers": {
      "type": "array", "default": [],
      "items": {
        "type": "object", "additionalProperties": false, "required": ["width", "points"],
        "properties": { "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 }, "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } } }
      }
    },
    "deployment": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["side", "polygon"],
        "properties": { "side": { "type": "integer", "minimum": 0, "maximum": 7 }, "polygon": { "$ref": "#/$defs/polygon" } }
      }
    },
    "reinforcement_edges": {
      "type": "array", "default": [],
      "items": {
        "type": "object", "additionalProperties": false, "required": ["side", "edge"],
        "properties": { "side": { "type": "integer", "minimum": 0, "maximum": 7 }, "edge": { "$ref": "#/$defs/edge" } }
      }
    },
    "structures": { "type": "array", "default": [], "items": { "type": "object" }, "description": "Reserved for walls, gates and towers (Phase 5); parsed and stored inert." },
    "siege_points": { "type": "array", "default": [], "items": { "type": "object" }, "description": "Reserved for ladders, rams and towers (Phase 5); parsed and stored inert." }
  }
}
